{%- comment -%}
  Holo Product Slider — Poke-Collect
  Holographic, tilt-on-hover product cards in a swipeable slider.
  Add via: Online Store > Themes > Edit code > sections > Add a new section (name: holo-product-slider), paste this file, Save.
  Then: Customize > Add section > "Holo Product Slider".
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign coll = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

{% style %}
  #holo-{{ sid }} {
    --holo-bg: {{ section.settings.bg_color }};
    --holo-text: {{ section.settings.text_color }};
    --holo-accent: {{ section.settings.accent_color }};
    --holo-card: {{ section.settings.card_color }};
    background: var(--holo-bg);
    color: var(--holo-text);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }
  #holo-{{ sid }} .holo-wrap { max-width: {% if section.settings.full_width %}none{% else %}1400px{% endif %}; margin: 0 auto; padding: 0 clamp(16px, 2.5vw, 40px); }
  #holo-{{ sid }} .holo-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 22px; }
  #holo-{{ sid }} .holo-title { margin: 0; font-size: clamp(24px, 3vw, 36px); line-height: 1.1; letter-spacing: .5px; }
  #holo-{{ sid }} .holo-title .holo-badge {
    display: inline-block; font-size: .55em; vertical-align: middle; margin-right: 10px; padding: 4px 10px; border-radius: 999px;
    background: linear-gradient(90deg,#ff6ec4,#ffd36e,#6effa0,#6ed8ff,#b86eff); color: #111; font-weight: 800; letter-spacing: 1px;
  }
  #holo-{{ sid }} .holo-sub { margin: 6px 0 0; opacity: .75; font-size: 15px; }
  #holo-{{ sid }} .holo-nav { display: flex; gap: 8px; flex-shrink: 0; }
  #holo-{{ sid }} .holo-btn {
    width: 44px; height: 44px; border-radius: 50%; border: 2px solid currentColor; background: transparent; color: inherit;
    cursor: pointer; display: grid; place-items: center; transition: background .2s, color .2s, opacity .2s;
  }
  #holo-{{ sid }} .holo-btn:hover { background: var(--holo-accent); border-color: var(--holo-accent); color: #fff; }
  #holo-{{ sid }} .holo-btn[disabled] { opacity: .3; cursor: default; background: transparent; color: inherit; border-color: currentColor; }
  #holo-{{ sid }} .holo-viewall {
    box-sizing: border-box; display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 14px 0 18px; margin-right: 6px;
    border-radius: 12px; background: var(--holo-accent); color: #fff; text-decoration: none; white-space: nowrap;
    font-size: 14px; font-weight: 800; letter-spacing: .3px; line-height: 1;
    box-shadow: 0 4px 12px rgba(226,47,57,.25); transition: transform .15s, box-shadow .2s; -webkit-tap-highlight-color: transparent;
  }
  #holo-{{ sid }} .holo-viewall:hover { transform: translateY(-1px); box-shadow: 0 8px 18px rgba(226,47,57,.32); color: #fff; }
  #holo-{{ sid }} .holo-viewall:active { transform: scale(.98); }
  #holo-{{ sid }} .holo-viewall:focus-visible { outline: 3px solid #262626; outline-offset: 2px; }
  #holo-{{ sid }} .holo-viewall .holo-more-count { font-weight: 600; opacity: .8; font-size: 13px; }

  #holo-{{ sid }} .holo-track {
    --cols: {{ section.settings.columns_desktop }}; --gap: {% if section.settings.columns_desktop > 4 %}16px{% else %}22px{% endif %};
    display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols)); gap: var(--gap);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; padding: 18px 12px 44px; margin: -18px -12px -30px; scroll-padding-left: 12px;
    scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  #holo-{{ sid }} .holo-track::-webkit-scrollbar { display: none; }
  {%- if section.settings.columns_desktop > 5 %}
  @media (max-width: 1599px) { #holo-{{ sid }} .holo-track { --cols: 5; } }
  {%- endif %}
  @media (max-width: 1280px) { #holo-{{ sid }} .holo-track { --cols: {% if section.settings.columns_desktop > 4 %}4{% else %}{{ section.settings.columns_desktop }}{% endif %}; } }
  @media (max-width: 1000px) { #holo-{{ sid }} .holo-track { --cols: 3; --gap: 16px; } }
  @media (max-width: 760px)  { #holo-{{ sid }} .holo-track { grid-auto-columns: 72%; gap: 14px; } #holo-{{ sid }} .holo-btn { display: none; }
    #holo-{{ sid }} .holo-head { align-items: flex-start; gap: 12px; }
  }

  #holo-{{ sid }} .holo-slide { scroll-snap-align: start; }
  #holo-{{ sid }} .holo-card {
    --mx: 50%; --my: 50%; --rx: 0deg; --ry: 0deg; --o: 0;
    position: relative; display: block; border-radius: 18px; overflow: hidden; text-decoration: none; color: #1a1a1a;
    background: var(--holo-card); aspect-ratio: 5 / 7;
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry)); isolation: isolate; -webkit-backface-visibility: hidden; backface-visibility: hidden;
    transition: transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .45s;
    box-shadow: 0 1px 3px rgba(17,24,39,.06), 0 6px 16px rgba(17,24,39,.07);
    will-change: transform;
  }
  #holo-{{ sid }} .holo-card.is-active { transition: transform .08s linear, box-shadow .3s; box-shadow: 0 4px 10px rgba(17,24,39,.08), 0 16px 32px rgba(17,24,39,.12); }
  /* foil frame */
  #holo-{{ sid }} .holo-card::before {
    content: ""; position: absolute; inset: 0; border-radius: inherit; padding: 6px; pointer-events: none; z-index: 4;
    background: linear-gradient(135deg,#f9d976,#e6b84a 25%,#fff3c4 50%,#d9a63c 75%,#f9d976);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
  }
  #holo-{{ sid }} .holo-inner { position: absolute; inset: 6px; border-radius: 13px; overflow: hidden; clip-path: inset(0 round 13px); display: flex; flex-direction: column;
    background: radial-gradient(120% 80% at 50% 0%, #ffffff 0%, #eef3ff 55%, #dfe7fb 100%); }
  #holo-{{ sid }} .holo-img { flex: 1; display: grid; place-items: center; padding: 18px 16px 4px; min-height: 0; }
  #holo-{{ sid }} .holo-img img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; filter: drop-shadow(0 4px 6px rgba(17,24,39,.12)); transition: transform .45s; }
  #holo-{{ sid }} .holo-card.is-active .holo-img img { transform: scale(1.04); }
  #holo-{{ sid }} .holo-info { position: relative; z-index: 2; padding: 10px 14px 14px; background: linear-gradient(180deg,rgba(255,255,255,0),rgba(255,255,255,.85) 30%); }
  #holo-{{ sid }} .holo-vendor { font-size: 11px; text-transform: uppercase; letter-spacing: 1.2px; opacity: .6; margin: 0 0 2px; }
  #holo-{{ sid }} .holo-name { font-size: 15px; font-weight: 800; line-height: 1.25; margin: 0 0 8px;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  #holo-{{ sid }} .holo-price { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 17px; }
  #holo-{{ sid }} .holo-price s { font-weight: 500; opacity: .55; font-size: 14px; }
  #holo-{{ sid }} .holo-price { flex-wrap: wrap; }
  {%- if section.settings.columns_desktop > 4 %}
  @media (min-width: 1001px) and (max-width: 1599px) {
    #holo-{{ sid }} .holo-name { font-size: 13px; }
    #holo-{{ sid }} .holo-price { font-size: 15px; gap: 6px; }
    #holo-{{ sid }} .holo-vendor { font-size: 10px; }
    #holo-{{ sid }} .holo-info { padding: 8px 11px 11px; }
    #holo-{{ sid }} .holo-img { padding: 14px 12px 2px; }
    #holo-{{ sid }} .holo-tag { top: 11px; left: 11px; font-size: 10px; padding: 4px 7px; }
  }
  {%- endif %}
  #holo-{{ sid }} .holo-variant { font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 4px; background: #1a1a1a; color: #fff; white-space: nowrap; }
  #holo-{{ sid }} .holo-tag { position: absolute; top: 14px; left: 14px; z-index: 5; font-size: 11px; font-weight: 800; letter-spacing: 1px;
    padding: 5px 9px; border-radius: 6px; background: var(--holo-accent); color: #fff; text-transform: uppercase; }
  #holo-{{ sid }} .holo-tag.is-soldout { background: #222; }

  /* holographic rainbow layer */
  #holo-{{ sid }} .holo-shine {
    position: absolute; inset: 0; z-index: 3; pointer-events: none; border-radius: inherit; clip-path: inset(0 round 18px); opacity: calc(.15 + var(--o) * .65);
    mix-blend-mode: color-dodge; transition: opacity .4s;
    background:
      repeating-linear-gradient(115deg,
        hsl(0 100% 70% / .55) 0%, hsl(50 100% 70% / .55) 5%, hsl(120 100% 70% / .55) 10%,
        hsl(190 100% 70% / .55) 15%, hsl(260 100% 75% / .55) 20%, hsl(320 100% 70% / .55) 25%, hsl(0 100% 70% / .55) 30%),
      repeating-linear-gradient(45deg, rgba(255,255,255,.12) 0 2px, transparent 2px 6px);
    background-size: 300% 300%, 100% 100%;
    background-position: var(--mx) var(--my), center;
    filter: brightness(.9) contrast(1.4) saturate(1.2);
  }
  /* sparkle texture */
  #holo-{{ sid }} .holo-sparkle {
    position: absolute; inset: 0; z-index: 3; pointer-events: none; border-radius: inherit; clip-path: inset(0 round 18px); opacity: calc(var(--o) * .6); mix-blend-mode: overlay;
    background-image:
      radial-gradient(circle at 20% 30%, #fff 0 1px, transparent 2px),
      radial-gradient(circle at 70% 20%, #fff 0 1px, transparent 2px),
      radial-gradient(circle at 40% 70%, #fff 0 1.5px, transparent 2.5px),
      radial-gradient(circle at 85% 65%, #fff 0 1px, transparent 2px),
      radial-gradient(circle at 10% 85%, #fff 0 1px, transparent 2px);
    background-size: 90px 90px, 120px 120px, 70px 70px, 110px 110px, 80px 80px;
    background-position: calc(var(--mx) * .3) calc(var(--my) * .3);
    transition: opacity .4s;
  }
  /* moving glare */
  #holo-{{ sid }} .holo-glare {
    position: absolute; inset: 0; z-index: 3; pointer-events: none; border-radius: inherit; clip-path: inset(0 round 18px); mix-blend-mode: overlay; opacity: var(--o); transition: opacity .4s;
    background: radial-gradient(circle at var(--mx) var(--my), rgba(255,255,255,.9) 0%, rgba(255,255,255,.35) 18%, rgba(0,0,0,.25) 70%);
  }
  /* idle shimmer so cards look holo even on touch / before hover */
  @keyframes holoIdle { 0% { background-position: 0% 50%, center; } 100% { background-position: 300% 50%, center; } }
  #holo-{{ sid }} .holo-card:not(.is-active) .holo-shine { animation: holoIdle 9s linear infinite; }


  /* ---- Add to cart (bottom-right of each card) ---- */
  #holo-{{ sid }} .holo-card { container-type: inline-size; }
  #holo-{{ sid }} .holo-link { position: absolute; inset: 0; z-index: 6; border-radius: inherit; }
  #holo-{{ sid }} .holo-link:focus-visible { outline: 3px solid var(--holo-accent); outline-offset: 3px; }
  #holo-{{ sid }} .holo-atc {
    position: absolute; right: 18px; bottom: 18px; z-index: 7;
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    box-sizing: border-box; height: 34px; padding: 0 13px 0 11px; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--holo-accent); color: #fff; font: inherit; font-size: 13px; font-weight: 800; letter-spacing: .2px; line-height: 1; white-space: nowrap;
    box-shadow: 0 2px 6px rgba(226,47,57,.28), 0 1px 2px rgba(17,24,39,.12);
    transition: transform .15s ease, box-shadow .2s, background .2s, opacity .2s; -webkit-tap-highlight-color: transparent;
  }
  #holo-{{ sid }} .holo-atc:hover { transform: translateY(-1px); box-shadow: 0 6px 14px rgba(226,47,57,.34), 0 2px 4px rgba(17,24,39,.14); }
  #holo-{{ sid }} .holo-atc:active { transform: scale(.96); }
  #holo-{{ sid }} .holo-atc:focus-visible { outline: 3px solid #262626; outline-offset: 2px; }
  #holo-{{ sid }} .holo-atc svg { flex-shrink: 0; }
  #holo-{{ sid }} .holo-atc .holo-atc-ok { display: none; }
  #holo-{{ sid }} .holo-atc.is-added { background: #262626; box-shadow: 0 2px 6px rgba(17,24,39,.25); }
  #holo-{{ sid }} .holo-atc.is-added .holo-atc-ic { display: none; }
  #holo-{{ sid }} .holo-atc.is-added .holo-atc-ok { display: block; }
  #holo-{{ sid }} .holo-atc.is-loading { pointer-events: none; }
  #holo-{{ sid }} .holo-atc.is-loading .holo-atc-ic { animation: holoAtcPulse .7s ease-in-out infinite alternate; }
  #holo-{{ sid }} .holo-atc.is-error { background: #262626; }
  @keyframes holoAtcPulse { from { transform: translateY(0); } to { transform: translateY(-3px); } }
  /* keep the price clear of the button */
  #holo-{{ sid }} .holo-card.has-atc .holo-price { padding-right: 118px; min-height: 34px; }
  /* narrow cards: round icon-only button */
  @container (max-width: 225px) {
    #holo-{{ sid }} .holo-atc { width: 36px; height: 36px; padding: 0; }
    #holo-{{ sid }} .holo-atc .holo-atc-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    #holo-{{ sid }} .holo-card.has-atc .holo-price { padding-right: 44px; min-height: 36px; }
  }

  /* ---- Mobile 'View all' button under the slider ---- */
  #holo-{{ sid }} .holo-more { display: none; }
  @media (max-width: 760px) {
    #holo-{{ sid }} .holo-nav { display: none; }
    #holo-{{ sid }} .holo-more { display: block; margin-top: 14px; }
    #holo-{{ sid }} .holo-more a {
      box-sizing: border-box; display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 50px; padding: 12px 18px;
      border-radius: 14px; background: var(--holo-accent); color: #fff; text-decoration: none; font-size: 15px; font-weight: 800; letter-spacing: .3px;
      box-shadow: 0 4px 12px rgba(226,47,57,.25); -webkit-tap-highlight-color: transparent; transition: transform .15s;
    }
    #holo-{{ sid }} .holo-more a:active { transform: scale(.98); }
    #holo-{{ sid }} .holo-more .holo-more-count { font-weight: 600; opacity: .8; font-size: 13px; }
    #holo-{{ sid }} .holo-more svg { margin-left: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    #holo-{{ sid }} .holo-card { transform: none !important; transition: none; }
    #holo-{{ sid }} .holo-card .holo-shine { animation: none !important; }
    #holo-{{ sid }} .holo-track { scroll-behavior: auto; }
  }
{% endstyle %}

<section id="holo-{{ sid }}" class="holo-section" data-holo-section data-tilt="{{ section.settings.tilt }}">
  <div class="holo-wrap">
    <div class="holo-head">
      <div>
        <h2 class="holo-title">
          {%- if section.settings.badge != blank -%}<span class="holo-badge">{{ section.settings.badge | escape }}</span>{%- endif -%}
          {{ section.settings.title | escape }}
        </h2>
        {%- if section.settings.subtitle != blank -%}<p class="holo-sub">{{ section.settings.subtitle | escape }}</p>{%- endif -%}
      </div>
      <div class="holo-nav">
        {%- if section.settings.show_view_all and coll != blank -%}
          <a class="holo-viewall" href="{{ coll.url }}"><span>View All</span><span class="holo-more-count">{{ coll.products_count }} items</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- endif -%}
        <button type="button" class="holo-btn" data-holo-prev aria-label="Previous">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="holo-btn" data-holo-next aria-label="Next">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="holo-track" data-holo-track>
      {%- if coll != blank and coll.products.size > 0 -%}
        {%- for product in coll.products limit: limit -%}
          {%- comment -%} Card price: 'highest_available' features the highest-priced in-stock variant (best for singles); 'lowest' is the Shopify default. {%- endcomment -%}
          {%- liquid
            assign card_variant = nil
            if section.settings.price_mode == 'highest_available'
              assign best_price = -1
              for vv in product.variants
                if vv.available and vv.price > best_price
                  assign best_price = vv.price
                  assign card_variant = vv
                endif
              endfor
            endif
            if card_variant == nil
              assign card_variant = product.selected_or_first_available_variant
            endif
            if section.settings.price_mode == 'highest_available'
              assign card_price = card_variant.price
              assign card_compare = card_variant.compare_at_price
              assign card_url = card_variant.url
            else
              assign card_price = product.price
              assign card_compare = product.compare_at_price
              assign card_url = product.url
            endif
          -%}
          <div class="holo-slide">
            <div class="holo-card{% if product.available %} has-atc{% endif %}" data-holo-card>
              <a class="holo-link" href="{{ card_url }}" aria-label="{{ product.title | escape }}"></a>
              {%- unless product.available -%}
                <span class="holo-tag is-soldout">{{ section.settings.soldout_label | escape }}</span>
              {%- else -%}
                {%- if section.settings.new_label != blank -%}<span class="holo-tag">{{ section.settings.new_label | escape }}</span>{%- endif -%}
              {%- endunless -%}
              <div class="holo-inner">
                <div class="holo-img">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.featured_image.alt, widths: '350, 500, 700', sizes: '(max-width: 760px) 70vw, 25vw' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <div class="holo-info">
                  {%- if section.settings.show_vendor -%}<p class="holo-vendor">{{ product.vendor | escape }}</p>{%- endif -%}
                  <p class="holo-name">{{ product.title | escape }}</p>
                  <div class="holo-price">
                    <span>{{ card_price | money }}</span>
                    {%- if card_compare > card_price -%}<s>{{ card_compare | money }}</s>{%- endif -%}
                    {%- if section.settings.show_variant_label and section.settings.price_mode == 'highest_available' and product.has_only_default_variant == false -%}<span class="holo-variant">{{ card_variant.title | escape }}</span>{%- endif -%}
                  </div>
                </div>
              </div>
              <span class="holo-shine"></span>
              <span class="holo-sparkle"></span>
              <span class="holo-glare"></span>
              {%- if product.available -%}
                <button type="button" class="holo-atc" data-holo-atc data-variant-id="{{ card_variant.id }}" aria-label="Add {{ product.title | escape }} to cart"><svg class="holo-atc-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 8H6.2"/><circle cx="9.5" cy="20" r="1.3"/><circle cx="17.5" cy="20" r="1.3"/></svg><svg class="holo-atc-ok" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span class="holo-atc-label">Add to Cart</span></button>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="holo-slide">
            <div class="holo-card" data-holo-card>
              <div class="holo-inner"><div class="holo-img">{{ 'product-1' | placeholder_svg_tag }}</div>
                <div class="holo-info"><p class="holo-name">Choose a collection</p></div></div>
              <span class="holo-shine"></span><span class="holo-sparkle"></span><span class="holo-glare"></span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.show_view_all and coll != blank -%}
      <div class="holo-more">
        <a href="{{ coll.url }}"><span>View All {{ section.settings.title | escape }}</span><span class="holo-more-count">{{ coll.products_count }} items</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    function initHolo(root) {
      if (!root || root.getAttribute('data-holo-ready')) return;
      root.setAttribute('data-holo-ready', '1');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var maxTilt = parseFloat(root.getAttribute('data-tilt')) || 14;
      var noHover = window.matchMedia && window.matchMedia('(hover: none), (pointer: coarse)').matches;

      if (!noHover) root.querySelectorAll('[data-holo-card]').forEach(function (card) {
        var raf = null;
        function move(x, y) {
          var r = card.getBoundingClientRect();
          var px = Math.min(Math.max((x - r.left) / r.width, 0), 1);
          var py = Math.min(Math.max((y - r.top) / r.height, 0), 1);
          if (raf) cancelAnimationFrame(raf);
          raf = requestAnimationFrame(function () {
            card.style.setProperty('--mx', (px * 100).toFixed(1) + '%');
            card.style.setProperty('--my', (py * 100).toFixed(1) + '%');
            if (!reduce) {
              card.style.setProperty('--ry', ((px - 0.5) * 2 * maxTilt).toFixed(2) + 'deg');
              card.style.setProperty('--rx', ((0.5 - py) * 2 * maxTilt).toFixed(2) + 'deg');
            }
            card.style.setProperty('--o', '1');
          });
        }
        function reset() {
          if (raf) cancelAnimationFrame(raf);
          card.classList.remove('is-active');
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
          card.style.setProperty('--mx', '50%');
          card.style.setProperty('--my', '50%');
          card.style.setProperty('--o', '0');
        }
        card.addEventListener('pointerenter', function () { card.classList.add('is-active'); });
        card.addEventListener('pointermove', function (e) { card.classList.add('is-active'); move(e.clientX, e.clientY); });
        card.addEventListener('pointerleave', reset);
        card.addEventListener('pointercancel', reset);
      });


      /* ---- Add to cart buttons ---- */
      root.querySelectorAll('[data-holo-atc]').forEach(function (btn) {
        var label = btn.querySelector('.holo-atc-label');
        var original = label ? label.textContent : '';
        var timer = null;
        function flash(cls, text, ms) {
          clearTimeout(timer);
          btn.classList.remove('is-loading', 'is-added', 'is-error');
          if (cls) btn.classList.add(cls);
          if (label && text) label.textContent = text;
          timer = setTimeout(function () { btn.classList.remove(cls); if (label) label.textContent = original; }, ms);
        }
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          if (btn.classList.contains('is-loading')) return;
          btn.classList.add('is-loading');
          var cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification') || document.querySelector('cart-items');
          var fd = new FormData();
          fd.append('id', btn.getAttribute('data-variant-id'));
          fd.append('quantity', '1');
          if (cart && typeof cart.getSectionsToRender === 'function') {
            fd.append('sections', cart.getSectionsToRender().map(function (s) { return s.id; }));
            fd.append('sections_url', window.location.pathname);
            if (typeof cart.setActiveElement === 'function') cart.setActiveElement(btn);
          }
          var url = (window.routes && window.routes.cart_add_url) || '/cart/add';
          fetch(url, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/javascript' }, body: fd })
            .then(function (r) { return r.json(); })
            .then(function (res) {
              if (res.status) {
                flash('is-error', 'Max in cart', 2200);
                if (typeof window.pushErrorMessage === 'function') window.pushErrorMessage(res.description || res.message);
                return;
              }
              flash('is-added', 'Added', 1800);
              if (cart && typeof cart.renderContents === 'function') {
                cart.renderContents(res);
                if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
              } else if (!cart) {
                window.location = (window.routes && window.routes.cart_url) || '/cart';
                return;
              }
              document.dispatchEvent(new CustomEvent('afterCartChanged', { detail: { productVariantId: fd.get('id'), source: 'holo-slider', cartData: res } }));
            })
            .catch(function () { flash('is-error', 'Try again', 2200); });
        });
      });

      var track = root.querySelector('[data-holo-track]');
      var prev = root.querySelector('[data-holo-prev]');
      var next = root.querySelector('[data-holo-next]');
      if (!track) return;
      function step() {
        var s = track.querySelector('.holo-slide');
        return s ? s.getBoundingClientRect().width + (parseFloat(getComputedStyle(track).columnGap) || 0) : track.clientWidth;
      }
      function update() {
        if (!prev || !next) return;
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      }
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }); });
      track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
      window.addEventListener('resize', update);
      update();

      /* ---- Auto-shine for phones & tablets (no hover) ----
         The card that snaps into view gets a holo sweep: glare and rainbow glide across it with a gentle tilt. */
      if (noHover && !reduce) {
        var cards = Array.prototype.slice.call(root.querySelectorAll('[data-holo-card]'));
        var SWEEP = 2600, PAUSE = 1200;
        var current = null, startTime = 0, rafId = null, onScreen = true, settleTimer = null;

        function setVars(card, mx, my, rx, ry, o) {
          card.style.setProperty('--mx', mx.toFixed(1) + '%');
          card.style.setProperty('--my', my.toFixed(1) + '%');
          card.style.setProperty('--rx', rx.toFixed(2) + 'deg');
          card.style.setProperty('--ry', ry.toFixed(2) + 'deg');
          card.style.setProperty('--o', o.toFixed(3));
        }
        function clearCard(card) {
          if (!card) return;
          card.classList.remove('is-active');
          setVars(card, 50, 50, 0, 0, 0);
        }
        function pickCard() {
          var tr = track.getBoundingClientRect(), best = null, bestVis = 0;
          cards.forEach(function (c) {
            var r = c.getBoundingClientRect();
            var vis = Math.min(r.right, tr.right) - Math.max(r.left, tr.left);
            if (vis > bestVis + 1) { bestVis = vis; best = c; }
          });
          return best;
        }
        function frame(t) {
          rafId = null;
          if (!current || !onScreen) return;
          var cycle = (t - startTime) % (SWEEP + PAUSE);
          if (cycle < SWEEP) {
            var p = cycle / SWEEP;
            var e = 0.5 - 0.5 * Math.cos(Math.PI * p);
            var arc = Math.sin(Math.PI * p);
            setVars(current, -10 + 120 * e, 25 + 50 * e, arc * maxTilt * 0.35, (e - 0.5) * 2 * maxTilt * 0.6, arc);
          } else {
            setVars(current, 50, 50, 0, 0, 0);
          }
          rafId = requestAnimationFrame(frame);
        }
        function startOn(card) {
          if (current && current !== card) clearCard(current);
          current = card;
          if (!card) return;
          card.classList.add('is-active');
          startTime = performance.now();
          if (!rafId && onScreen) rafId = requestAnimationFrame(frame);
        }
        function stop() {
          if (rafId) cancelAnimationFrame(rafId);
          rafId = null;
          clearCard(current);
          current = null;
        }
        track.addEventListener('scroll', function () {
          if (current) stop();
          clearTimeout(settleTimer);
          settleTimer = setTimeout(function () { startOn(pickCard()); }, 180);
        }, { passive: true });
        cards.forEach(function (c) {
          c.addEventListener('touchstart', function () { if (c !== current) startOn(c); else startTime = performance.now(); }, { passive: true });
        });
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(function (entries) {
            onScreen = entries[0].isIntersecting;
            if (onScreen) { if (!current) startOn(pickCard()); else if (!rafId) rafId = requestAnimationFrame(frame); }
          }, { threshold: 0.25 }).observe(root);
        }
        startOn(pickCard());
      }
    }
    function initAll() { document.querySelectorAll('[data-holo-section]').forEach(initHolo); }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initAll); } else { initAll(); }
    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

{% schema %}
{
  "name": "Holo Product Slider",
  "tag": "div",
  "class": "holo-product-slider",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge text", "default": "NEW" },
    { "type": "text", "id": "title", "label": "Title", "default": "Pokémon Plush" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Official Pokémon Center plush — hover a card to see it shine!" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "columns_desktop", "label": "Cards visible on desktop", "min": 3, "max": 6, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "full_width", "label": "Full page width", "info": "Lets the cards use the whole screen width on large monitors so they're bigger.", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "select", "id": "price_mode", "label": "Card price", "options": [
      { "value": "highest_available", "label": "Highest-priced in-stock variant (best for singles)" },
      { "value": "lowest", "label": "Lowest variant price (Shopify default)" }
    ], "default": "highest_available" },
    { "type": "checkbox", "id": "show_variant_label", "label": "Show condition of the featured variant", "info": "Shows e.g. 'Near Mint' next to the price when using the highest in-stock price.", "default": true },
    { "type": "text", "id": "new_label", "label": "Card tag (in stock)", "default": "New" },
    { "type": "text", "id": "soldout_label", "label": "Card tag (sold out)", "default": "Coming soon" },
    { "type": "range", "id": "tilt", "label": "Tilt strength (degrees)", "min": 0, "max": 25, "step": 1, "default": 14 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#14141f" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent (buttons & tags)", "default": "#e22f39" },
    { "type": "color", "id": "card_color", "label": "Card base", "default": "#ffffff" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [
    { "name": "Holo Product Slider" }
  ]
}
{% endschema %}
